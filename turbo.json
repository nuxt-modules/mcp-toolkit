{
  "$schema": "https://turborepo.dev/schema.v2.json",
  "ui": "tui",
  "noUpdateNotifier": true,
  "globalPassThroughEnv": [
    "CI",
    "GITHUB_ACTIONS",
    "GITHUB_EVENT_NAME",
    "GITHUB_REF",
    "GITHUB_SHA"
  ],
  "globalEnv": [
    "AI_GATEWAY_API_KEY",
    "STUDIO_SSO_URL",
    "STUDIO_SSO_CLIENT_ID",
    "STUDIO_SSO_CLIENT_SECRET"
  ],
  "globalDependencies": [".env"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "dev:prepare"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".vercel/output/**", "dist/**", ".output/**", ".nuxt/**"]
    },
    "dev": {
      "dependsOn": ["dev:prepare"],
      "cache": false,
      "persistent": true
    },
    "dev:prepare": {
      "dependsOn": ["^dev:prepare"],
      "outputs": ["dist/**", ".output/**", ".nuxt/**"]
    },
    "lint": {
      "dependsOn": ["dev:prepare"]
    },
    "lint:fix": {
      "dependsOn": ["dev:prepare"],
      "cache": false
    },
    "lint:package": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["dev:prepare"]
    },
    "eval": {
      "cache": false
    },
    "eval:ui": {
      "cache": false,
      "persistent": true
    }
  }
}
