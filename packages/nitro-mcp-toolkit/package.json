{
  "name": "nitro-mcp-toolkit",
  "version": "0.0.1",
  "description": "Framework-agnostic MCP server toolkit built directly on Nitro v3 and the MCP SDK v2.",
  "keywords": [
    "ai",
    "h3",
    "llm",
    "mcp",
    "modelcontextprotocol",
    "nitro",
    "tools"
  ],
  "homepage": "https://github.com/nuxt-modules/mcp-toolkit/tree/main/packages/nitro-mcp-toolkit#readme",
  "bugs": "https://github.com/nuxt-modules/mcp-toolkit/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt-modules/mcp-toolkit.git",
    "directory": "packages/nitro-mcp-toolkit"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/runtime/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/runtime/index.d.mts",
      "import": "./dist/runtime/index.mjs"
    },
    "./module": {
      "types": "./dist/module/index.d.mts",
      "import": "./dist/module/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.mts",
      "import": "./dist/testing/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "build": "obuild",
    "dev:prepare": "obuild --stub",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint . --fix && oxfmt .",
    "lint:package": "publint && attw --pack . --profile esm-only",
    "prepack": "obuild",
    "release:alpha": "npm --no-workspaces version $VERSION --no-git-tag-version --allow-same-version && pnpm publish --tag alpha --no-git-checks && npm --no-workspaces dist-tag add nitro-mcp-toolkit@$VERSION latest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@modelcontextprotocol/client": "2.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "h3": "2.0.1-rc.22",
    "nitro": "3.0.260610-beta",
    "obuild": "^0.4.38",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "publint": "^0.3.22",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "h3": "^2.0.1-rc.22",
    "nitro": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
