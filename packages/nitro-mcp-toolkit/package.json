{
  "name": "nitro-mcp-toolkit",
  "version": "0.0.1",
  "description": "Framework-agnostic MCP server toolkit built directly on Nitro v3 and MCP SDK v2 (spec 2026-07-28).",
  "type": "module",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt-modules/mcp-toolkit.git",
    "directory": "packages/nitro-mcp-toolkit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev:prepare": "tsdown",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.16.0",
    "eslint": "^10.8.0",
    "nitro": "3.0.260610-beta",
    "tsdown": "^0.21.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  }
}
