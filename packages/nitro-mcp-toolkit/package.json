{
  "name": "nitro-mcp-toolkit",
  "version": "0.4.0",
  "description": "MCP server toolkit for Nitro 2 and Nitro 3, built on h3-mcp.",
  "keywords": [
    "ai",
    "h3",
    "llm",
    "mcp",
    "modelcontextprotocol",
    "nitro",
    "tools"
  ],
  "homepage": "https://github.com/nuxt-modules/mcp-toolkit/tree/main/packages/nitro-mcp-toolkit#readme",
  "bugs": "https://github.com/nuxt-modules/mcp-toolkit/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt-modules/mcp-toolkit.git",
    "directory": "packages/nitro-mcp-toolkit"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/runtime/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/runtime/index.d.mts",
      "import": "./dist/runtime/index.mjs"
    },
    "./oauth/clerk": {
      "types": "./dist/runtime/oauth/clerk.d.mts",
      "import": "./dist/runtime/oauth/clerk.mjs"
    },
    "./oauth/okta": {
      "types": "./dist/runtime/oauth/okta.d.mts",
      "import": "./dist/runtime/oauth/okta.mjs"
    },
    "./oauth/workos": {
      "types": "./dist/runtime/oauth/workos.d.mts",
      "import": "./dist/runtime/oauth/workos.mjs"
    },
    "./servers": {
      "types": "./dist/runtime/servers.d.mts",
      "import": "./dist/runtime/servers.mjs"
    },
    "./module": {
      "types": "./dist/module/index.d.mts",
      "import": "./dist/module/index.mjs",
      "default": "./dist/module/index.mjs"
    },
    "./testing": {
      "types": "./dist/testing/index.d.mts",
      "import": "./dist/testing/index.mjs"
    },
    "./package.json": "./package.json",
    "./module/nitro2": {
      "types": "./dist/module/nitro2.d.mts",
      "import": "./dist/module/nitro2.mjs",
      "default": "./dist/module/nitro2.mjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "obuild",
    "dev:prepare": "obuild --stub",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint . --fix && oxfmt .",
    "lint:package": "publint && attw --pack . --profile esm-only",
    "prepack": "obuild",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "bench:catalog": "node benchmarks/catalog.bench.ts",
    "bench:consumer": "node benchmarks/consumer.ts"
  },
  "dependencies": {
    "h3": "^2.0.8",
    "h3-mcp": "0.2.0",
    "jose": "^6.2.13",
    "pathe": "^2.0.3",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@modelcontextprotocol/client": "2.4.0",
    "@valibot/to-json-schema": "^1.8.0",
    "@vitest/coverage-v8": "^4.1.12",
    "nitro": "3.0.260610-beta",
    "nitropack": "^2.13.4",
    "obuild": "^0.4.45",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "publint": "^0.3.25",
    "typescript": "~6.0.3",
    "valibot": "^1.5.0",
    "vitest": "^4.1.12",
    "zod": "^4.2.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "nitro": "3.0.260610-beta || ^3.0.0",
    "nitropack": "^2.13.4"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    },
    "nitro": {
      "optional": true
    },
    "nitropack": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.19"
  }
}
