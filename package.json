{
  "name": "@nuxtjs/mcp-toolkit-monorepo",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt-modules/mcp-toolkit.git"
  },
  "author": "Hugo Richard <hugo.richard@vercel.com>",
  "license": "MIT",
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "turbo run dev --filter=@nuxtjs/mcp-toolkit-playground",
    "dev:nitro": "turbo run dev --filter=nitro-mcp-toolkit-playground",
    "probe:nitro": "pnpm --filter nitro-mcp-toolkit-playground --silent probe",
    "dev:starter": "turbo run dev --filter=@nuxtjs/mcp-toolkit-starter",
    "dev:prepare": "turbo run dev:prepare",
    "dev:docs": "turbo run dev --filter=@nuxtjs/mcp-toolkit-docs",
    "build": "turbo run build",
    "build:module": "turbo run build --filter=@nuxtjs/mcp-toolkit",
    "build:nitro": "turbo run build --filter=nitro-mcp-toolkit",
    "build:docs": "turbo run build --filter=@nuxtjs/mcp-toolkit-docs",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:docs": "turbo run lint --filter=@nuxtjs/mcp-toolkit-docs",
    "lint:package": "turbo run lint:package --filter=nitro-mcp-toolkit",
    "test": "turbo run test --filter=@nuxtjs/mcp-toolkit --filter=nitro-mcp-toolkit",
    "test:coverage": "turbo run test:coverage --filter=nitro-mcp-toolkit",
    "typecheck": "turbo run typecheck",
    "typecheck:docs": "turbo run typecheck --filter=@nuxtjs/mcp-toolkit-docs",
    "eval": "turbo run eval --filter=@nuxtjs/mcp-toolkit-docs",
    "eval:ui": "turbo run eval:ui --filter=@nuxtjs/mcp-toolkit-docs",
    "clean": "turbo run clean",
    "automd": "npx automd --config .config/automd.json",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo run build --filter='./packages/*' && changeset publish"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@nuxt/eslint-config": "^1.17.0",
    "eslint": "^10.8.1",
    "turbo": "^2.10.9",
    "typescript": "~6.0.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
